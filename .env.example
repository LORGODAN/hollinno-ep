# Copy this file to .env for local testing. On Render, add these as Environment Variables instead.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the service_role (secret) key. Never put it in front-end code or share it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Any long random text, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The one admin account. It is created automatically on first start.
# Changing ADMIN_PASSWORD here and restarting also changes the admin's password.
ADMIN_NAME=Admin
ADMIN_PHONE=0999000000
ADMIN_PASSWORD=choose-a-strong-password

PORT=3000
# Set to production on Render
NODE_ENV=development
